{
  "name": "science-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests e2e worker/github-sync/index.ts *.ts *.json",
    "format:check": "prettier --check src scripts tests e2e worker/github-sync/index.ts *.ts *.json"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "ajv": "^8.20.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
