      "answer": [
        "true"
      ],
      "source": {
        "file": "小学高年级科学实验探索建模_200题训练题库.md",
        "number": 9
      },
      "explanation": "完全浸没时排水体积相同；浓盐水密度更大，排开的液体更重，产生的浮力通常更大。"
    },
